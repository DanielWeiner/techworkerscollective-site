{
    "$schema": "https://schemas.wp.org/trunk/theme.json",
    "version": 3,
    "settings": {
        "layout": {
            "contentSize": "1200px",
            "wideSize": "1200px"
        },
        "color": {
            "palette": [
                {
                    "color": "#FFFFFF",
                    "name": "Base",
                    "slug": "base"
                },
                {
                    "color": "#1E1A34",
                    "name": "Contrast",
                    "slug": "contrast"
                },
                {
                    "color": "#B7B3C4",
                    "name": "Brand Light Purple",
                    "slug": "brand-light-purple"
                },
                {
                    "color": "#DDDAE8",
                    "name": "Brand Bright Purple",
                    "slug": "brand-bright-purple"
                }
            ]
        },
        "typography": {
            "fluid": true,
            "fontStyle": true,
            "fontWeight": true,
            "letterSpacing": true,
            "lineHeight": true,
            "textAlign": true,
            "textColumns": true,
            "textTransform": true,
            "textDecoration": true,
            "dropCap": true,
            "customFontSize": true,
            "fontFamilies": [
                {
                    "name": "Primary",
                    "slug": "primary",
                    "fontFamily": "Corben, cursive",
                    "fontFace": [
                        {
                            "fontFamily": "Corben",
                            "fontWeight": "400",
                            "fontStyle": "normal",
                            "fontStretch": "normal",
                            "src": [
                                "file:./assets/fonts/Corben-Regular.ttf"
                            ]
                        },
                        {
                            "fontFamily": "Corben",
                            "fontWeight": "700",
                            "fontStyle": "normal",
                            "fontStretch": "normal",
                            "src": [
                                "file:./assets/fonts/Corben-Bold.ttf"
                            ]
                        }
                    ]
                },
                {
                    "name": "Primary Alt",
                    "slug": "primary-alt",
                    "fontFamily": "'Instrument Serif', serif",
                    "fontFace": [
                        {
                            "fontFamily": "Instrument Serif",
                            "fontWeight": "400",
                            "fontStyle": "normal",
                            "fontStretch": "normal",
                            "src": [
                                "file:./assets/fonts/InstrumentSerif-Regular.ttf"
                            ]
                        },
                        {
                            "fontFamily": "Instrument Serif",
                            "fontWeight": "400",
                            "fontStyle": "italic",
                            "fontStretch": "normal",
                            "src": [
                                "file:./assets/fonts/InstrumentSerif-Italic.ttf"
                            ]
                        }
                    ]
                },
                {
                    "name": "Secondary Alt",
                    "slug": "secondary-alt",
                    "fontFamily": "'Host Grotesk', sans-serif",
                    "fontFace": [
                        {
                            "fontFamily": "Host Grotesk",
                            "fontWeight": "300 400 500 600 700 800",
                            "fontStyle": "normal",
                            "fontStretch": "normal",
                            "src": [
                                "file:./assets/fonts/HostGrotesk-VariableFont_wght.ttf"
                            ]
                        },
                        {
                            "fontFamily": "Host Grotesk",
                            "fontWeight": "300 400 500 600 700 800",
                            "fontStyle": "italic",
                            "fontStretch": "normal",
                            "src": [
                                "file:./assets/fonts/HostGrotesk-Italic-VariableFont_wght.ttf"
                            ]
                        }
                    ]
                },
                {
                    "name": "Secondary",
                    "slug": "secondary",
                    "fontFamily": "'Instrument Sans', sans-serif",
                    "fontFace": [
                        {
                            "fontFamily": "Instrument Sans",
                            "fontWeight": "400 500 600 700",
                            "fontStyle": "normal",
                            "fontStretch": "normal",
                            "src": [
                                "file:./assets/fonts/InstrumentSans-VariableFont_wdth,wght.ttf"
                            ]
                        },
                        {
                            "fontFamily": "Instrument Sans",
                            "fontWeight": "400 500 600 700",
                            "fontStyle": "italic",
                            "fontStretch": "normal",
                            "src": [
                                "file:./assets/fonts/InstrumentSans-Italic-VariableFont_wdth,wght.ttf"
                            ]
                        }
                    ]
                }
            ]
        }
    },
    "styles": {
        "spacing": {
    		"padding": {
                "left": "0px",
                "right": "0px"
            }
    	},	
        "color": {
            "background": "var(--wp--preset--color--contrast)",
            "text": "var(--wp--preset--color--base)"
        },
        "typography": {
            "fontFamily": "var(--wp--preset--font-family--secondary)",
            "fontWeight": "400"
        },
        "elements": {
            "heading": {
                "typography": {
                    "fontFamily": "var(--wp--preset--font-family--secondary)",
                    "fontWeight": "400"
                }
            }
        },
        "blocks": {
            "core/heading": {
                "variations": {
                    "alt": {
                        "typography": {
                            "fontFamily": "var(--wp--preset--font-family--primary-alt)",
                            "fontWeight": "400",
                            "letterSpacing": "-4%"
                        }
                    },
                    "sans-serif": {
                        "typography": {
                            "fontFamily": "var(--wp--preset--font-family--secondary)",
                            "fontWeight": "400",
                            "letterSpacing": "-2%"
                        }
                    }
                }
            },
            "core/paragraph": {
                "variations": {
                    "alt": {
                        "typography": {
                            "fontFamily": "var(--wp--preset--font-family--secondary-alt)",
                            "fontWeight": "400"
                        }
                    },
                    "alt-serif": {
                        "typography": {
                            "fontFamily": "var(--wp--preset--font-family--primary-alt)",
                            "fontWeight": "400"
                        }
                    }
                }
            },
            "core/columns": {
                "color": {
                    "background": "var(--wp--preset--color--base)",
                    "text": "var(--wp--preset--color--contrast)"
                },
                "border": {
                    "radius": "4rem",
                    "color": "var(--wp--preset--color--contrast)",
                    "width": "2px",
                    "style": "solid"
                },
                "spacing": {
                    "padding": {
                        "top": "2.5rem",
                        "bottom": "2.5rem",
                        "left": "4rem",
                        "right": "4rem"
                    }
                },
                "variations": {
                    "default": {
                        "color": {
                            "background": "var(--wp--preset--color--base)",
                            "text": "var(--wp--preset--color--contrast)"
                        }
                    },
                    "dark": {
                        "color": {
                            "background": "var(--wp--preset--color--contrast)",
                            "text": "var(--wp--preset--color--base)"
                        }
                    }
                }
            },
             "core/group": {
                "color": {
                    "background": "var(--wp--preset--color--base)",
                    "text": "var(--wp--preset--color--contrast)"
                },
                "variations": {
                    "default": {
                        "color": {
                            "background": "var(--wp--preset--color--base)",
                            "text": "var(--wp--preset--color--contrast)"
                        }
                    },
                    "banner": {
                        "spacing": {
                            "padding": {
                                "top": "calc(2.5rem + 20rem)",
                                "bottom": "2.5rem",
                                "left": "4rem",
                                "right": "4rem"
                            }
                        },
                        "border": {
                            "radius": "4rem",
                            "color": "var(--wp--preset--color--contrast)",
                            "width": "2px",
                            "style": "solid"
                        }
                    },
                    "dark": {
                        "color": {
                            "background": "var(--wp--preset--color--contrast)",
                            "text": "var(--wp--preset--color--base)"
                        }
                    }
                }
            },
            "core/post-content": {
                "spacing": {
                    "blockGap": "0px",
                    "padding": {
                        "top": "0px",
                        "bottom": "0px",
                        "left": "0px",
                        "right": "0px"
                    }
                }
            },
            "core/site-title": {
                "typography": {
                    "fontFamily": "var(--wp--preset--font-family--secondary)",
                    "fontWeight": "400",
                    "fontSize": "var(--wp--preset--font-size--x-large)"
                }
            },
            "core/button":{
                "color": {
                    "text": "var(--wp--preset--color--contrast)",
                    "background": "var(--wp--preset--color--brand-light-purple)"
                },
                ":hover": {
                    "color": {
                        "text": "var(--wp--preset--color--base)",
                        "background": "var(--wp--preset--color--contrast)"
                    },
                    "border": {
                        "width": "2px",
                        "style": "solid",
                        "color": "var(--wp--preset--color--brand-light-purple)"
                    }
                }
            },
            "jetpack/input": {
                "typography": {
                    "fontSize": "medium"
                },
                "color": {
                    "text": "var(--wp--preset--color--base)",
                    "background": "var(--wp--preset--color--contrast)"
                },
                "border": {
                    "radius": "2rem",
                    "top": {
                        "width": "0px"
                    },
                    "width": "2px"
                    
                }
            }
        }
    },
    "customTemplates": [],
    "templateParts": [
        {
            "name": "logo",
            "title": "SVG Logo",
            "area": "uncategorized"
        }
    ],
    "patterns": []
}